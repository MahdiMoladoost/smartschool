# SmartSchool local development environment
NODE_ENV=development
PORT=3000
REQUIRE_DB=true

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=smart_school

# Auth
JWT_SECRET=replace_with_a_long_random_local_secret_min_32_chars
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AI / GapGPT - optional until configured
AI_API_BASE_URL=https://api.gapgpt.app/v1
AI_API_KEY=
AI_DEFAULT_MODEL=gpt-4o
AI_TIMEOUT_MS=30000
AI_RETRY_ATTEMPTS=2

# SMS - optional until provider is configured
SMS_PROVIDER=generic_json
SMS_API_KEY=
SMS_SENDER_NUMBER=9982002811
SMS_API_URL=
SMS_TIMEOUT_MS=12000
SMS_RETRY_ATTEMPTS=2
SMS_DUPLICATE_WINDOW_SECONDS=300

# Development safety
SMS_DRY_RUN=true
