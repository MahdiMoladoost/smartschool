<%
    const aboutPageData = (typeof aboutPage !== 'undefined' && aboutPage) ? aboutPage : {};
    const hero = aboutPageData.hero || {};
    const intro = aboutPageData.intro || {};
    const stats = Array.isArray(aboutPageData.stats) ? aboutPageData.stats : [];
    const sections = Array.isArray(aboutPageData.sections) ? aboutPageData.sections : [];
    const staff = aboutPageData.staff || {};
    const teachers = Array.isArray(staff.members) ? staff.members : [];
    const cta = aboutPageData.cta || {};
%>
<%- include('../partials/header', { title: hero.title || 'درباره ما', activePage: 'about' }) %>
<script>document.documentElement.classList.add('about-no-fouc-loading');</script>
<style id="about-no-fouc-guard">
html.about-no-fouc-loading body:not([data-shared-home-layout-ready]){visibility:hidden!important;opacity:0!important;background:#f8fafc!important;}
body[data-shared-home-layout-ready]{visibility:visible!important;opacity:1!important;}
body > .top-bar:not([data-shared-home-layout]),
body > header:not([data-shared-home-layout]),
body > .main-header:not([data-shared-home-layout]),
body > nav.navbar:not([data-shared-home-layout]),
body > .navbar:not([data-shared-home-layout]),
body > footer:not([data-shared-home-layout]){display:none!important;}


/* premium teacher cards override */
.about-teacher-card,.teacher-full-card{background:linear-gradient(180deg,#fff 0%,#f9fbff 100%)!important;border:1px solid #dbeafe!important;border-radius:34px!important;box-shadow:0 22px 55px rgba(15,23,42,.075)!important}
.about-teacher-card:before,.teacher-full-card:before{height:6px!important;background:linear-gradient(90deg,#2563eb 0%,#06b6d4 55%,#22c55e 100%)!important}
.teacher-avatar{width:152px!important;height:152px!important;border-radius:36px!important;background:linear-gradient(135deg,#eff6ff,#ffffff)!important;border:1px solid #bfdbfe!important;box-shadow:0 18px 42px rgba(37,99,235,.14)!important}
.about-teacher-card h3,.teacher-full-card h3{font-size:1.32rem!important;margin-top:.25rem!important}
.teacher-specialty-pill,.teacher-full-card strong{background:linear-gradient(135deg,#eff6ff,#fff)!important;border:1px solid #bfdbfe!important;color:#1d4ed8!important;box-shadow:0 8px 18px rgba(37,99,235,.06)!important}
.teacher-meta span{background:linear-gradient(180deg,#fff,#f8fafc)!important;border:1px solid #dbeafe!important;border-radius:18px!important}

</style>
