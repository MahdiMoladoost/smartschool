<script id="SMART_CHAT_CLEAN_SCRIPT">
(function () {
    function escapeHTML(text) {
        return String(text).replace(/[&<>"']/g, function (ch) {
            return ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]);
        });
    }

    function timeNow() {
        try {
            return new Intl.DateTimeFormat('fa-IR', { hour: '2-digit', minute: '2-digit' }).format(new Date());
        } catch (e) {
            return 'اکنون';
        }
    }

    window.handleChatKeyPress = function(event) {
        if (event.key === 'Enter') {
            event.preventDefault();
            window.sendChatMessage();
        }
    };

    window.sendQuickMessage = function(message) {
        const input = document.getElementById('chatbotInputFarz');
        if (!input) return;
        input.value = message;
        window.sendChatMessage();
    };

    window.getBotResponse = function(message) {
        const text = String(message || '').trim();
        if (text.includes('ثبت') || text.includes('نام')) {
            return 'برای ثبت‌نام، اطلاعات دانش‌آموز را وارد کنید؛ سپس مدارک لازم، زمان مراجعه و مراحل تکمیل پرونده نمایش داده می‌شود.';
        }
        if (text.includes('امکانات')) {
            return 'امکانات مدرسه شامل کلاس‌های هوشمند، ارتباط با اولیا، گزارش‌گیری آموزشی، برنامه هفتگی و اطلاع‌رسانی آنلاین است.';
        }
        if (text.includes('ارتباط') || text.includes('تماس')) {
            return 'برای ارتباط با مدرسه می‌توانید از شماره تماس، فرم پیام یا بخش ارتباط با ما استفاده کنید.';
        }
        if (text.includes('اخبار') || text.includes('رویداد')) {
            return 'آخرین اخبار، اطلاعیه‌ها و رویدادهای مدرسه در بخش اخبار و رویدادها قابل مشاهده است.';
        }
        return 'پیام شما دریافت شد. لطفاً درباره ثبت‌نام، امکانات، اخبار یا ارتباط با مدرسه سؤال خود را بپرسید.';
    };

    window.sendChatMessage = function() {
        const input = document.getElementById('chatbotInputFarz');
        const messages = document.getElementById('chatbotMessagesFarz');
        if (!input || !messages) return;

        const raw = input.value.trim();
        if (!raw) return;

        messages.insertAdjacentHTML('beforeend', `
            <div class="smart-message-row user">
                <div class="smart-message-content">
                    <div class="smart-bubble user-bubble">${escapeHTML(raw)}</div>
                    <span class="smart-time user-time">${timeNow()} <i class="ri-check-double-line"></i></span>
                </div>
            </div>
        `);

        input.value = '';
        messages.scrollTop = messages.scrollHeight;

        setTimeout(function () {
            messages.insertAdjacentHTML('beforeend', `
                <div class="smart-message-row bot">
                    <div class="smart-mini-avatar">
                        <i class="ri-robot-2-line"></i>
                    </div>
                    <div class="smart-message-content">
                        <div class="smart-bubble bot-bubble">${escapeHTML(window.getBotResponse(raw))}</div>
                        <span class="smart-time">${timeNow()}</span>
                    </div>
                </div>
            `);
            messages.scrollTop = messages.scrollHeight;
        }, 420);
    };
})();
</script>

